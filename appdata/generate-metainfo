#!/usr/bin/env python3
"""Write the ZeGrapher metainfo file, which software centers read.

    generate-metainfo [--output PATH [--depfile PATH]]

Without --output, the file goes to stdout. appdata/meson.build runs the script
during the build and installs the output. --depfile lists the files the script
read, so ninja reruns it when one of them changes. The script doesn't read git
history, so a release tarball and a clone give the same file.

appdata/ZeGrapher.metainfo.xml.in is the template. The script fills in four
blocks:

  {{ description }}  website/content/<lang>/2-features.md, in every language.
                     AppStream pairs paragraphs and list items one by one, so
                     the script stops if a translation has a different number
                     of them.
  {{ screenshots }}  one <screenshot> per picture in the build.yaml 'gallery'
                     list, with one <image> per language that has its own
                     copy of the picture. Each strings.yaml 'gallery' mapping
                     gives the captions.
  {{ urls }}         the homepage, issue tracker, source code and donation
                     page, from website/build-config/build.yaml.
  {{ releases }}     one <release> per full release in appdata/releases.yaml,
                     newest first, up to the meson.build version. Each release
                     takes the text of the announcement that ends on it, or
                     else of the changes entry.

Picture URLs point at the GitHub repository at the release tag. A '-dev'
version has no tag yet, so its URLs point at the branch.
"""

import argparse
import html
import re
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
APPDATA = ROOT / "appdata"
TEMPLATE = APPDATA / "ZeGrapher.metainfo.xml.in"
FEATURES_NAME = "2-features.md"

sys.path[:0] = [str(APPDATA), str(ROOT / "website" / "scripts")]

import content  # noqa: E402
import releases  # noqa: E402

BRANCH = "master"


def languages():
    """The features panel in each language that has one, English first."""
    english = content.CONTENT / content.SOURCE / FEATURES_NAME
    if not english.is_file():
        sys.exit(f"{english} is missing, and every translation follows it")

    found = {lang: content.CONTENT / lang / FEATURES_NAME
             for lang in content.languages()}

    return {lang: path for lang, path in found.items() if path.is_file()}


def inline(text):
    """Markdown converted to the inline markup that AppStream accepts."""
    text = re.sub(r"\[([^\]]+)\]\([^)]+\)", r"\1", text)  # keep the link text, drop the URL
    text = html.escape(text, quote=False)
    text = re.sub(r"\*\*(.+?)\*\*", r"<em>\1</em>", text)
    text = re.sub(r"`(.+?)`", r"<code>\1</code>", text)
    return " ".join(text.split())


def blocks_of(markdown):
    """The paragraphs and list items of a markdown text, in order.

    AppStream has no nested lists, so an indented item joins the outer list.
    The '# ' heading is the site panel title, so it is dropped.
    """
    blocks, kind, buffer = [], None, []

    def flush():
        if buffer:
            blocks.append((kind, inline(" ".join(buffer))))
            buffer.clear()

    for line in markdown.splitlines():
        stripped = line.strip()

        if stripped.startswith("#"):
            flush()
            kind = None
        elif not stripped:
            flush()
            kind = None
        elif re.match(r"^[-*] ", stripped):
            flush()
            kind, buffer[:] = "li", [re.sub(r"^[-*] ", "", stripped)]
        else:
            if kind is None:
                flush()
                kind = "p"
            buffer.append(stripped)

    flush()
    return blocks


def markup(blocks, indent, translations=None):
    """The blocks as AppStream markup, one element per line.

    Each run of list items gets a <ul>: AppStream requires it, and markdown has
    no such tag. 'translations' maps a language to its blocks. Each element is
    followed by its translations.
    """
    lines, in_list = [], False

    for i, (kind, text) in enumerate(blocks):
        if kind == "li" and not in_list:
            lines.append(f"{indent}<ul>")
            in_list = True
        elif kind == "p" and in_list:
            lines.append(f"{indent}</ul>")
            in_list = False

        pad = indent + "  " if kind == "li" else indent
        lines.append(f"{pad}<{kind}>{text}</{kind}>")

        for lang, other in (translations or {}).items():
            lines.append(f'{pad}<{kind} xml:lang="{lang}">{other[i][1]}</{kind}>')

    if in_list:
        lines.append(f"{indent}</ul>")

    return lines


def description():
    """<description>, one element per block, each followed by its translations."""
    per_lang = {lang: blocks_of(path.read_text(encoding="utf-8"))
                for lang, path in languages().items()}
    english = per_lang.pop(content.SOURCE)

    for lang, blocks in per_lang.items():
        if [kind for kind, _ in blocks] != [kind for kind, _ in english]:
            sys.exit(f"website/content/{lang}/{FEATURES_NAME} has "
                     f"{len(blocks)} paragraphs and list items, and the English "
                     f"file has {len(english)}. AppStream pairs them one by one, "
                     f"so a translation must keep the English structure.")

    return "\n".join(["  <description>"]
                     + markup(english, "    ", per_lang)
                     + ["  </description>"])


def gallery_names():
    """The pictures in the build.yaml 'gallery' list, in order."""
    names = content.read_conf().get("gallery")
    if not names:
        sys.exit(f"{content.CONF_FILE}: 'gallery' is empty")

    return names


def image_ref():
    """The git revision in the picture URLs.

    A release build uses its tag, so the URLs keep showing the pictures the
    release shipped with. A '-dev' version has no tag, so it uses the branch.
    """
    version = releases.project_version()

    return BRANCH if releases.release_type(version) == "dev" else f"v{version}"


def screenshots():
    """<screenshots>, with each picture's translations first and English last.

    The pictures follow the build.yaml gallery order. A language without its own
    copy of a picture doesn't get an <image> for it.

    A distribution's DEP-11 catalog keeps only the last image of each
    screenshot, so the English image, which has no language tag, comes last.
    """
    english_images = content.CONTENT / content.SOURCE / content.PICTURES
    if not english_images.is_dir():
        sys.exit(f"{english_images} is missing")

    raw = content.repository_url(content.read_conf()).replace(
        "https://github.com/", "https://raw.githubusercontent.com/", 1)
    ref = image_ref()
    names = gallery_names()
    others = sorted(lang for lang in languages() if lang != content.SOURCE)
    captions = {lang: content.captions(lang) for lang in [content.SOURCE] + others}

    lines = ["  <screenshots>"]

    for i, name in enumerate(names):
        if not (english_images / name).is_file():
            sys.exit(f"{english_images / name} is missing, and the build.yaml "
                     f"gallery lists it")

        default = ' type="default"' if i == 0 else ""
        lines.append(f"    <screenshot{default}>")

        if name not in captions[content.SOURCE]:
            sys.exit(f"website/content/{content.SOURCE}/{content.STRINGS} has no "
                     f"'gallery' caption for {name}")
        for lang in [content.SOURCE] + others:
            if name in captions[lang]:
                tag = "" if lang == content.SOURCE else f' xml:lang="{lang}"'
                caption = html.escape(captions[lang][name], quote=False)
                lines.append(f"      <caption{tag}>{caption}</caption>")

        for lang in others + [content.SOURCE]:
            if not (content.CONTENT / lang / content.PICTURES / name).is_file():
                continue
            tag = "" if lang == content.SOURCE else f' xml:lang="{lang}"'
            lines.append(f"      <image{tag}>{raw}/{ref}/website/content/"
                         f"{lang}/{content.PICTURES}/{name}</image>")
        lines.append("    </screenshot>")

    lines.append("  </screenshots>")
    return "\n".join(lines)


def urls():
    """The homepage, issue tracker, source code and donation page <url>s."""
    conf = content.read_conf()
    repository = content.repository_url(conf)

    return "\n".join(f'  <url type="{kind}">{html.escape(url)}</url>'
                     for kind, url in (("homepage", content.homepage_url(conf)),
                                       ("bugtracker", f"{repository}/issues"),
                                       ("vcs-browser", repository),
                                       ("donation", content.donate_url(conf))))


def releases_xml():
    """One <release> per full release in releases.yaml, newest first."""
    lines = []

    for release in releases.announced():
        blocks = markup(blocks_of(release.text), "        ")
        version = release.tag.removeprefix("v")
        opening = f'    <release version="{version}" date="{release.date}"'

        if not blocks:
            lines.append(opening + "/>")
            continue

        lines.append(opening + ">")
        lines.append("      <description>")
        lines += blocks
        lines.append("      </description>")
        lines.append("    </release>")

    return "\n".join(lines)


def metainfo():
    """The template with its four blocks filled in."""
    blocks = {"description": description(),
              "screenshots": screenshots(),
              "urls": urls(),
              "releases": releases_xml()}

    template = TEMPLATE.read_text(encoding="utf-8")
    return re.sub(r"^{{\s*(\w+)\s*}}$", lambda m: blocks[m.group(1)],
                  template, flags=re.M)


def dependencies():
    """Every file and folder the metainfo file comes from.

    Picture folders are listed as folders: adding a picture changes the folder
    mtime. Missing paths are left out, because ninja would rerun the script on
    every build.
    """
    found = [Path(__file__).resolve(), Path(releases.__file__).resolve(),
             Path(content.__file__).resolve(), TEMPLATE, releases.MESON_BUILD,
             releases.RELEASES, content.CONF_FILE,
             *languages().values(),
             *(content.CONTENT / lang / content.PICTURES for lang in content.languages()),
             *(content.CONTENT / lang / content.STRINGS for lang in content.languages())]

    return [path for path in found if path.exists()]


def main():
    parser = argparse.ArgumentParser(add_help=False)
    parser.add_argument("--output")
    parser.add_argument("--depfile")
    args, rest = parser.parse_known_args()

    if rest or (args.depfile and not args.output):
        sys.exit(__doc__)

    text = metainfo()

    if args.output is None:
        sys.stdout.write(text)
        return 0

    path = Path(args.output)
    # an identical write still updates the file's mtime and reruns every step
    # that reads the file, so skip it
    if not path.is_file() or path.read_text(encoding="utf-8") != text:
        path.write_text(text, encoding="utf-8")

    if args.depfile:
        escaped = [str(dep).replace(" ", "\\ ") for dep in dependencies()]
        Path(args.depfile).write_text(f"{args.output}: {' '.join(escaped)}\n",
                                      encoding="utf-8")

    return 0


if __name__ == "__main__":
    sys.exit(main())
