<?xml version="1.0" encoding="UTF-8"?>
<!--
  appdata/generate-metainfo writes the metainfo file out of this template, and
  appdata/meson.build installs what it writes.
-->
<component type="desktop-application">
  <id>com.zegrapher.ZeGrapher</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>AGPL-3.0-or-later</project_license>
  <name>ZeGrapher</name>
  <summary>Fast and intuitive math graphing software</summary>
  <summary xml:lang="de">Schnelles und eingängiges Programm für mathematische Graphen</summary>
  <summary xml:lang="es">Programa de gráficas matemáticas, rápido e intuitivo</summary>
  <summary xml:lang="fr">Logiciel de tracé de courbes, rapide et intuitif</summary>
  <summary xml:lang="it">Software di grafici matematici, rapido e intuitivo</summary>
  <summary xml:lang="ja">軽快で直感的に使える数学グラフ作成ソフト</summary>
  <summary xml:lang="pt">Programa de gráficos matemáticos, rápido e intuitivo</summary>
  <summary xml:lang="ru">Быстрая и понятная программа для математических графиков</summary>
  <summary xml:lang="zh">快速、易上手的数学绘图软件</summary>
{{ description }}
{{ screenshots }}
  <launchable type="desktop-id">ZeGrapher.desktop</launchable>
  <provides>
    <mediatype>application/x-zegrapher</mediatype>
  </provides>
  <url type="homepage">https://zegrapher.com/</url>
  <url type="bugtracker">https://github.com/AdelKS/ZeGrapher/issues</url>
  <developer id="com.zegrapher">
    <name>Adel Kara Slimane</name>
  </developer>
  <update_contact>adel.ks@zegrapher.com</update_contact>
  <content_rating type="oars-1.1"/>
  <releases>
{{ releases }}
    <!-- the releases that came before appdata/release-notes.md -->
    <release version="3.1.1" date="2020-07-20"/>
    <release version="3.1" date="2020-01-04"/>
    <release version="3.0.2" date="2017-10-09"/>
    <release version="3.0.1" date="2017-03-06"/>
    <release version="3.0" date="2016-04-15"/>
  </releases>
</component>
