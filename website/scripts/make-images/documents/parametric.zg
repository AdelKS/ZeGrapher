math_objects:
  - type: equation
    equation: X(t) = 2*cos(3*t)
    style: {visible: false}
  - type: equation
    equation: Y(t) = 2*sin(2*t)
    style: {visible: false}
  - type: parametric
    first: X
    second: Y
    start: '0'
    end: '2*math::pi'
graph:
  range:
    x: {min: '-2.5', max: '2.5'}
    y: {min: '-2.5', max: '2.5'}
app:
  language: en
  window_size: {width: 1332, height: 769}
  pane_width: 483
