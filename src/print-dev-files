#!/bin/bash

SCRIPT_DIR=$( cd -- "$( dirname -- "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )

pushd "$SCRIPT_DIR" > /dev/null

echo "# BEGIN AUTOGEN SRC-LIST"
echo

echo "source_files = ["
for f in $(find . -type f -name "*.cpp" -and -not -name "main.cpp" | sort); do
    echo "  '${f#./}',"
done
echo "]"
echo

echo "moc_header_files = ["
for f in $(grep -E -lir --include=*.h "Q_OBJECT" . | sort -u ); do
    if ! grep -E "(Q_GADGET|QML_ELEMENT|QML_NAMED_ELEMENT|QML_ANONYMOUS)" "$f" &> /dev/null; then
        echo "  '${f#./}',"
    fi
done
echo "]"
echo

# qt6.qml_module() takes singletons in a separate list, so files that start
# with 'pragma Singleton' go in qml_singleton_files instead of qml_files
echo "qml_files = ["
for f in $(find . -type f -name "*.qml" | sort); do
    grep -q "^pragma Singleton" "$f" || echo "  '${f#./}',"
done
echo "]"
echo

echo "qml_singleton_files = ["
for f in $(grep -l -r --include=*.qml "^pragma Singleton" . | sort); do
    echo "  '${f#./}',"
done
echo "]"
echo

echo "qmlcpp_files = ["
for f in $(grep -E -lir --include=*.h "(Q_GADGET|QML_ELEMENT|QML_NAMED_ELEMENT|QML_ANONYMOUS)" . | sort); do
    echo "  '${f#./}',"
done
echo "]"
echo

echo "# END AUTOGEN SRC-LIST"

popd > /dev/null
